@model INV.App.Receipts.ReceiptDetail
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>فاتورة الاستلام</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: 20px;
            direction: rtl;
        }
        .container {
            max-width: 850px;
            height: 1230px;
            margin: auto;
            padding: 20px;
            border: 1px solid #ddd;
            box-shadow: 2px 2px 10px rgba(0,0,0,0.1);
        }
        h2 {
            text-align: right;
        }
        .header {
            display: flex;
            justify-content: space-between;
        }
        .invoice-info {
            text-align: left;
        }
        .bold {
            font-weight: bold;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        table, th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: right;
        }
        th {
            background-color: #f4f4f4;
        }
        .total {
            text-align: left;
            font-weight: bold;
        }
        .Col_Number {
            width: 5%;
        }
        .Col_Designation {
            width: 30%;
        }
        .Col_Unit {
            width: 6%;
        }
        .Col_Quantity {
            width: 10%;
        }
        .Col_Received {
            width: 10%;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <div class="invoice-info">
            <p class="bold">رقم الفاتورة: INT-001</p>
            <p>الحساب: 786-54984</p>
            <p>رقم الطلب: #92</p>
            <p>تاريخ الفاتورة: @Model.PurchaseOrder.Date</p>
            <p>تاريخ الإنجاز: @Model.PurchaseOrder.CompletionDelay</p>
        </div>
        <div>
            <h2>فاتورة الاستلام</h2>
            <p>@Model.PurchaseOrder.Supplier.CompanyName<br><br>@Model.PurchaseOrder.Supplier.Address</p>
            <p>الهاتف: @Model.PurchaseOrder.Supplier.Phone<br>البريد الإلكتروني: @Model.PurchaseOrder.Supplier.Email</p>
        </div>
    </div>
    <hr>
    <p class="bold">إلى السيد/ة</p>
    <p>محمد خيضر</p>
    <p>BP 145 RP، 07000<br>-عالية-</p>
    <p>الهاتف: +(213) 741-5790<br>البريد: email@univ-biskra.dz</p>

    <table>
        <tr>
            <th>رقم</th>
            <th>المنتج</th>
            <th>الوحدة</th>
            <th>الكمية</th>
            <th>تم الاستلام</th>
        </tr>
        @foreach (var product in Model.ReceiptProducts)
        {
            <tr>
                <td class="Col_Number">@(Model.ReceiptProducts.IndexOf(product) + 1)</td>
                <td class="Col_Designation">@product.Designation</td>
                <td class="Col_Unit">@product.UnitMeasure</td>
                <td class="Col_Quantity">@product.Quantity</td>
                <td class="Col_Received">@product.Received</td>
            </tr>
        }
    </table>
</div>
</body>
</html>
