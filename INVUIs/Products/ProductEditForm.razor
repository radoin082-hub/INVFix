@using INV.App.Purchases
@using INV.Domain.Entities.Products
@using INV.Domain.Entities.Purchases
@using INVUIs.Products.ProductsModel
@using INVUIs.Purchases
@using INVUIs.Purchases.PurchaseModels
@inject IStringLocalizer<Resources> Localizer

@if(display)
{
	<MyModal Titel=@Localizer["Product.Edit"]>
		<Pills>

			<RadzenTemplateForm TItem="PurchaseProductModel" Data="@selectedProductModel" Submit="@SaveEditedProduct">
				<RadzenStack Gap="1rem">
					<RadzenRow Style="display: flex; align-items: center;">
						<RadzenColumn Size="12" Style="text-align: left;">
							<RadzenLabel Text="@selectedProductModel.Designation"
							Style="font-size: 25px; font-weight: bold; color: #257180FF; display: block;" />
						</RadzenColumn>
					</RadzenRow>
					<RadzenRow>
						<RadzenColumn Size="4">
							<RadzenLabel Text=@Localizer["Quantity"] Style="font-size: 14px;" />
							<RadzenNumeric TValue="int" @bind-Value="selectedProductModel.Quantity" Min="1" Style="width: 100%; font-size: 14px;" />
						</RadzenColumn>
						<RadzenColumn Size="8">
							<RadzenLabel Text=@Localizer["UnitPrice"] Style="font-size: 14px;" />
							<RadzenNumeric TValue="decimal" @bind-Value="selectedProductModel.UnitPrice" Min="1" Style="width: 100%; font-size: 14px;" />
						</RadzenColumn>
					</RadzenRow>
					<RadzenRow Style="display: flex; justify-content: flex-end;">
						<RadzenColumn Size="12" Style="text-align: right;">
							<div class="footer-form mt-3">
								<RadzenButton Text=@Localizer["Cancel"] ButtonStyle="ButtonStyle.Danger" ButtonType="ButtonType.Button" Click="@CloseEditPopup" Style="font-size: 14px;" />
								<RadzenButton Text=@Localizer["Save"] ButtonStyle="ButtonStyle.Success" ButtonType="ButtonType.Submit" Style="margin-left: 1rem; font-size: 14px;" />

							</div>
								</RadzenColumn>
					</RadzenRow>
				</RadzenStack>
			</RadzenTemplateForm>

		</Pills>
	</MyModal>
}