@using INVUIs.Products.ProductsModel
@using INVUIs.Shared.Models
@inject IStringLocalizer<Resources> Localizer

@if (visibility)
{
    <MyModal Titel=@Localizer["Product.AddButton"]>
        
  <Pills>
            <RadzenTemplateForm TItem="ProductModel" Data="@productModel" Submit="@SubmitProduct" style="width: 370px;">
                <RadzenStack Gap="0.5rem">
                    
                    <RadzenRow Style="margin-bottom: 0.1rem;">
                        <RadzenColumn Size="12">
                            <RadzenLabel Text="@(Localizer["Designation"] + " *")" />
                            <RadzenTextArea Name="Designation" @bind-Value="productModel.Designation" Style="width: 100%;" />
                            <RadzenRequiredValidator Component="Designation" Text="Designation is required" />
                        </RadzenColumn>
                    </RadzenRow>
                    <div style="display:flex;gap:20px;">
                    <RadzenRow Style="margin-bottom: 0.1rem;">
                        <RadzenColumn Size="12">
                            <RadzenLabel Text="@(Localizer["UnitMeasure"] + " *")" />
                            <RadzenDropDown Name="UnitMeasure" @bind-Value="productModel.UnitMeasure" Data="@UnitMesures" Style="width: 100%;" />
                            <RadzenRequiredValidator Component="UnitMeasure" Text="Unit of Measure is required" />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Style="margin-bottom: 0.1rem;">
                        <RadzenColumn Size="12">
                            <RadzenLabel Text=@Localizer["TVA"] />
                            <RadzenDropDown Name="TVA" @bind-Value="productModel.TVA" Data="@TVAOptions"
                                            Style="width: 100%;" />

                        </RadzenColumn>
                    </RadzenRow>
                    </div>

                    <RadzenRow Style="margin-bottom: 0.1rem;">
                        <RadzenColumn Size="12">
                            <RadzenLabel Text=@Localizer["Warehouse"] />
                            <RadzenDropDown Name="WareHouse" @bind-Value="productModel.WareHouseId" Data="@wareHouses"
                                            TextProperty="Name" ValueProperty="Id" Style="width: 100%;" />
                        </RadzenColumn>
                    </RadzenRow>



                    <RadzenRow Style="display: flex; justify-content: flex-end;">
                        <RadzenColumn Size="12" Style="text-align: right;">
                            <div class="footer-form">
                                <RadzenButton Text=@Localizer["Cancel"] ButtonStyle="@ButtonStyle.Danger" ButtonType="ButtonType.Button" Click="@Hide" Style="font-size: 14px;" />
                                <RadzenButton Text=@Localizer["Save"] ButtonType="ButtonType.Submit" ButtonStyle="@ButtonStyle.Success" Style="font-size: 14px;" />

                            </div>
                                  </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenTemplateForm>
        </Pills>
    </MyModal>


}