@page "/products"
@using INV.App.Products
@using INV.Domain.Entities.Products
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject IStringLocalizer<Resources> Localizer


<button class="addsupplier-button" @onclick="() => productForm?.ShowModal()">
    <i class="bi bi-cart-plus"></i> @Localizer["Product.AddButton"]
</button>
<br />
<br />

@if (Products is null)
{
    <h3>@Localizer["Loading"]...</h3>
}
else
{
    <div class="Container-list">
        <RadzenDataGrid @ref="grid" Data="@Products" AllowSorting="true"
                        AllowFiltering="true" RowSelect="@((ProductInfo ProductInfo) => navigatepage(ProductInfo.Id))"
                        PageSize="8" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(ProductInfo.Designation)" Title=@Localizer["Designation"] Width="300px" />
                <RadzenDataGridColumn Property="@nameof(ProductInfo.Quantity)" Title=@Localizer["Quantity"] Width="100px" />
                <RadzenDataGridColumn Property="@nameof(ProductInfo.UnitMeasure)" Title=@Localizer["UnitMeasure"] Width="80px" Sortable="false" Filterable="false" />
                <RadzenDataGridColumn Property="@nameof(ProductInfo.WareHouse)" Title=@Localizer["Warehouse"] Width="200px" />

                <RadzenDataGridColumn Sortable="false" Filterable="false" Width="70px">
                    <Template Context="product">
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                      Click="(e => DeleteProduct(product.Id))"
                                      @onclick:stopPropagation="true">
                        </RadzenButton>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
}

<ProductEditForm @ref="productEditForm" selectedProductModel="newProduct" />

<ProductForm @ref="productForm" OnProductCreated="OnProductCreated" productEdit="productEdit" />
<ConformationForm @ref="conformationForm" Titel=@Localizer["DeleteProductTitle"] Message=@Localizer["DeleteProductMessage"] OnConfirm="ConfirmDeleteProduct" />
