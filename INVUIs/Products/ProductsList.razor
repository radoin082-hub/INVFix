@page "/products"
@using INV.App.Products
@using INV.Domain.Entities.Products
@inject NavigationManager Navigation
@rendermode InteractiveServer

<button class="addsupplier-button" @onclick="() => productForm?.ShowModal()">
    <i class="bi bi-cart-plus"></i> Add Product
</button>

@if (Products is null)
{
    <h3>Loading...</h3>
}
else
{
    <div class="Container-list">
        <RadzenDataGrid @ref="grid" Data="@Products" AllowSorting="true"
                        AllowFiltering="true" RowSelect="@((ProductInfo ProductInfo) => navigatepage(ProductInfo.Id))"
                        PageSize="8" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(ProductInfo.Designation)" Title="Designation" Width="300px" />
                <RadzenDataGridColumn Property="@nameof(ProductInfo.Quantity)" Title="Quantity" Width="100px" />
                <RadzenDataGridColumn Property="@nameof(ProductInfo.UnitMeasure)" Title="U.M" Width="48px" Sortable="false" Filterable="false" />
                <RadzenDataGridColumn Property="@nameof(ProductInfo.WareHouse)" Title="WareHouse" Width="200px" />

                <RadzenDataGridColumn Title="Actions" Sortable="false" Filterable="false" Width="100px">
                    <Template Context="product">
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                      Click="(e => DeleteProduct(product.Id))"
                                      @onclick:stopPropagation="true">
                        </RadzenButton>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
}

<ProductEditForm @ref="productEditForm" selectedProductModel="newProduct" />

<ProductForm @ref="productForm" OnProductCreated="async (product) => { Products.Add(product); await grid.Reload(); StateHasChanged(); }" productEdit="productEdit" />
<ConformationForm @ref="conformationForm" Titel="Delete Product" Message="Are you sure you want to delete this product?" OnConfirm="ConfirmDeleteProduct" />
