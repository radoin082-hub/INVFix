@page "/products"
@using INV.App.Products
@using INV.Domain.Entities.Products
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject IStringLocalizer<Resources> Localizer

<div class="search-zone">
    <div style="width:35%">
        <input type="text" @bind="searchTerm" placeholder=@Localizer["Search"] class="number-input" @bind:event="oninput" />
    </div>
    <div>
        <button class="addsupplier-button" @onclick="() => productForm?.ShowModal()">
            <i class="bi bi-cart-plus"></i> @Localizer["Product.AddButton"]
        </button>
    </div>
</div>

@if (Products is null)
{
    <h3>@Localizer["Loading"]...</h3>
}
else
{
    <div class="Container-list">
        <RadzenDataGrid @ref="grid" Data="@displayedItems" TItem="ProductInfo" AllowSorting="true"
                        AllowFiltering="true" RowSelect="@((ProductInfo ProductInfo) => navigatepage(ProductInfo.Id))"
                        PageSize="6" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn TItem="ProductInfo" Property="Designation" Title=@Localizer["Designation"] Width="300px" />
                <RadzenDataGridColumn TItem="ProductInfo" Property="@nameof(ProductInfo.Quantity)" Title=@Localizer["Quantity"] Width="100px" />
                <RadzenDataGridColumn TItem="ProductInfo" Property="@nameof(ProductInfo.UnitMeasure)" Title=@Localizer["UnitMeasure"] Width="80px" Sortable="false" Filterable="false" />
                <RadzenDataGridColumn TItem="ProductInfo" Property="@nameof(ProductInfo.WareHouse)" Title=@Localizer["Warehouse"] Width="200px" />

                <RadzenDataGridColumn TItem="ProductInfo" Sortable="false" Filterable="false" Width="70px">
                    <Template Context="product">
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                      Click="(e => DeleteProduct(product.Id))"
                                      @onclick:stopPropagation="true">
                        </RadzenButton>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
}

<ProductEditForm @ref="productEditForm" selectedProductModel="newProduct" />

<ProductForm @ref="productForm" OnProductCreated="OnProductCreated" productEdit="productEdit" />
<ConformationForm @ref="conformationForm" Titel=@Localizer["Product.DeleteButton"] Message=@Localizer["Product.DeleteMessage"] OnConfirm="ConfirmDeleteProduct" />
