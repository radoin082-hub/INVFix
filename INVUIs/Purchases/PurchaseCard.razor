@using INV.App.Purchases
@using INV.Domain.Entities.Purchases
@using INVUIs.Shared


@if (displayVisa)
{
    <div class="popup">
        <div class="popup-content">
            <input type="date" placeholder="Date Visa" @bind-value="purchaseInfo.VisaDate"/>
            <input type="text" placeholder="Number Visa" @bind-value="purchaseInfo.VisaNumber"/>
            <div class="footer-form">
                <button class="btn-custom btn-cancel" @onclick="HideVisa">Close</button>
                <button class="btn-custom btn-submit" @onclick="() => visa(purchaseInfo)">Save</button>

            </div>
        </div>
    </div>
}

@if (displayReject)
{
    <div class="popup">
        <div class="popup-content">
            <input type="date" placeholder="Date Visa" @bind-value="purchaseInfo.VisaDate"/>
            <input type="text" placeholder="Number Visa" @bind-value="purchaseInfo.VisaNumber"/>
            <input type="text" placeholder="Motif" @bind-value="purchaseInfo.Observation"/>
            <div class="footer-form">
                <button class="btn-custom btn-cancel" @onclick="HideReject">Close</button>
                <button class="btn-custom btn-submit" @onclick="() => reject(purchaseInfo)">Save</button>

            </div>
        </div>
    </div>
}

<RadzenCard>
    <RadzenRow>
        <RadzenColumn Size="9">
            <LabledValue Label="Number" Value="@purchaseInfo.Number" />
        
        </RadzenColumn>
        <RadzenColumn Size="3">
             @if (purchaseInfo.Status == PurchaseStatus.Editing)
    {
            <div style="display:flex;justify-content:end">
                <button @onclick="Showreject" class="btn-custom btn-delete">Reject</button>
                <button @onclick="ShowVisa" class="btn-custom btn-submit">Visa</button>
            </div>
    }
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow>
        <RadzenColumn Size="6">
            <LabledValue Label="Status" Status="@purchaseInfo.Status" />
            <LabledValue Label="Supplier Name" Value="@purchaseInfo.SupplierName" />
            <LabledValue Label="Date" Value="@purchaseInfo.Date.ToShortDateString()" />
            <LabledValue Label="Completion Delay" Number="@purchaseInfo.CompletionDelay" />

           

        </RadzenColumn>
        <RadzenColumn Size="6">
         
          
            <LabledValue Label="Budget Article" Value="@purchaseInfo.BudgeArticle" />
            <LabledValue Label="Service Type" ServiceType="@purchaseInfo.ServiceType" />
            <LabledValue Label="Budget Type" BudgeType="@purchaseInfo.BudgeType" />
            
           
        </RadzenColumn>
    </RadzenRow>
    @if (purchaseInfo.Status == PurchaseStatus.Vised || purchaseInfo.Status == PurchaseStatus.Reject)
    {
        <RadzenRow>
            <RadzenColumn Size="6">

                <LabledValue Label="Visi Date" Date="@purchaseInfo.VisaDate" />
                <LabledValue Label="Visi Number" Value="@purchaseInfo.VisaNumber" />
            </RadzenColumn>
            @if (purchaseInfo.Status == PurchaseStatus.Reject)
            {
            <RadzenColumn Size="6">

                <LabledValue Label="Observation" Value="@purchaseInfo.Observation" />
            </RadzenColumn>
            }
          

        </RadzenRow>
   }


</RadzenCard>



<style>
  .purchase-container{
      display:flex;
      flex-direction:column;
  }

        .purchase-info{
            display:flex;
        justify-content: flex-start;
     
        }

        .purchase-info-part2{
            margin-left:120px;
        }

        .purchase-info-part1 strong, .purchase-info-part2 strong, .purchase-visa strong {
        color: Var(--primary-color);
    }

 
</style>