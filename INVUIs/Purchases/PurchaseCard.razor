@using INV.App.Purchases
@using INV.Domain.Entities.Purchases
@using INVUIs.Shared
@inject IStringLocalizer<Resources> Localizer


@if (displayVisa)
{
    <div class="popup">
        <div class="popup-content">
         
            <input type="date" placeholder=@Localizer["Visa.Date"] @bind-value="purchaseInfo.VisaDate" />
            <input type="text" placeholder=@Localizer["Visa.Number"] @bind-value="purchaseInfo.VisaNumber" />

            <div class="footer-form">
         
                <button class="btn-custom btn-cancel" @onclick="HideVisa">@Localizer["Close"]</button>
                <button class="btn-custom btn-submit" @onclick="() => visa(purchaseInfo)">@Localizer["Save"]</button>

            </div>
        </div>
    </div>
}

@if (displayReject)
{
    <div class="popup">
        <div class="popup-content">
            <input type="date" placeholder=@Localizer["Visa.Date"] @bind-value="purchaseInfo.VisaDate" />
            <input type="text" placeholder=@Localizer["Visa.Number"] @bind-value="purchaseInfo.VisaNumber" />
            <input type="text" placeholder=@Localizer["Motif"] @bind-value="purchaseInfo.Observation" />
            <div class="footer-form">
                <button class="btn-custom btn-cancel" @onclick="HideReject">@Localizer["Close"]</button>
                <button class="btn-custom btn-submit" @onclick="() => reject(purchaseInfo)">@Localizer["Save"]</button>


            </div>
        </div>
    </div>
}

<RadzenCard>
    <RadzenRow>
        <RadzenColumn Size="9">
            <LabledValue Label=@Localizer["Number"] Value="@purchaseInfo.Number" />

        </RadzenColumn>
        <RadzenColumn Size="3">
             @if (purchaseInfo.Status == PurchaseStatus.Editing)
    {
            <div style="display:flex;justify-content:end">
                    <button @onclick="Showreject" class="btn-custom btn-delete">@Localizer["Reject"] </button>
                    <button @onclick="ShowVisa" class="btn-custom btn-submit">@Localizer["Visa"] </button>

            </div>
    }
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow>
        <RadzenColumn Size="6">
            <LabledValue Label=@Localizer["Status"] Status="@purchaseInfo.Status" />
            <LabledValue Label=@Localizer["Supplier.Name"] Value="@purchaseInfo.SupplierName" />
            <LabledValue Label=@Localizer["Date"] Value="@purchaseInfo.Date.ToShortDateString()" />
            <LabledValue Label=@Localizer["Delivery.Time"] Number="@purchaseInfo.CompletionDelay" />


        </RadzenColumn>
        <RadzenColumn Size="6">
         
          
            <LabledValue Label=@Localizer["BudgetArticle"] Value="@purchaseInfo.BudgeArticle" />
            <LabledValue Label=@Localizer["ServiceType"] ServiceType="@purchaseInfo.ServiceType" />
            <LabledValue Label=@Localizer["BudgetType"] BudgeType="@purchaseInfo.BudgeType" />



        </RadzenColumn>
    </RadzenRow>
    @if (purchaseInfo.Status == PurchaseStatus.Vised || purchaseInfo.Status == PurchaseStatus.Reject)
    {
        <RadzenRow>
            <RadzenColumn Size="6">

                <LabledValue Label=@Localizer["Visa.Date"] Date="@purchaseInfo.VisaDate" />
                <LabledValue Label=@Localizer["Visa.Number"] Value="@purchaseInfo.VisaNumber" />
            </RadzenColumn>
            @if (purchaseInfo.Status == PurchaseStatus.Reject)
            {
            <RadzenColumn Size="6">

                    <LabledValue Label=@Localizer["Observation"] Value="@purchaseInfo.Observation" />
            </RadzenColumn>
            }
          

        </RadzenRow>
   }


</RadzenCard>



<style>
  .purchase-container{
      display:flex;
      flex-direction:column;
  }

        .purchase-info{
            display:flex;
        justify-content: flex-start;
     
        }

        .purchase-info-part2{
            margin-left:120px;
        }

        .purchase-info-part1 strong, .purchase-info-part2 strong, .purchase-visa strong {
        color: Var(--primary-color);
    }

 
</style>