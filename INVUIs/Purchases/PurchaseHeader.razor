@using INVUIs.Shared.Models
@rendermode InteractiveServer
<EditForm Model="Purchase" OnValidSubmit="Save" FormName="purchaseForm" Enhance @ref="form">
    <DataAnnotationsValidator/>

    <CascadingValue Value="Chapters">
        <CascadingValue Value="Articles">
        <div style="display: grid;grid-template-columns: 1fr 1fr;grid-gap: 32px; padding-inline: 32px">
            <div>
                <CommandInput Label="Select a Budget:">
                        <InputSelect @bind-Value="Purchase.selectedCategory">
                        <option value="" selected disabled>--Select--</option>
                        <option value="1">Operating Expenses</option>
                        <option value="2">Equipment Expenses</option>
                        <option value="3">Other Expenses</option>
                    </InputSelect>
                </CommandInput>
                <CommandInput Label="Choose a Chapter:">
                        <InputSelect id="chapter" style="width: 6rem" @bind-Value="SelectedChapterCode"
                                 class="form-control valid">
                        <option value="" selected>--Select--</option>
                         @if (Chapters != null)
                        {
                                @foreach (var chapter in Chapters)
                                {
                                    <option value="@chapter.CodeChapter">@chapter.CodeChapter</option>
                                }
                        }
                    </InputSelect>
                        <InputText id="title" @bind-Value="Purchase.title_chapter" class="form-control valid"
                               readonly/>
                </CommandInput>

                <div class="input2">
                    <div class="commend-input">
                        <div class="label-input-group">
                            <label for="article" style="width: 10rem">Choose an Article:</label>
                                <InputSelect id="article" style="width: 6rem" @bind-Value="SelectedArticleCode"
                                         class="form-control valid">
                                <option value="" selected>--Select--</option>
                                    @if (Articles != null)
                                    {
                                        @foreach (var article in Articles)
                                        {
                                            <option value="@article.CodeArticle">@article.CodeArticle</option>
                                        }
                                    }
                                
                            </InputSelect>

                                <InputText id="description" @bind-Value="Purchase.description_article"
                                       class="form-control valid" placeholder="Enter Description" readonly/>
                        </div>
                    </div>
                </div>
            </div>
            <div>
                <CommandInput Label="Select a Service:">
                        <InputSelect @bind-Value="Purchase.selectedService">
                        <option value="" selected>--Select--</option>
                        <option value="1">Works</option>
                        <option value="2">Equipment</option>
                        <option value="3">Services</option>
                    </InputSelect>

                </CommandInput>
                <div class="commend-input">
                    <div class="label-input-group">
                        <label for="productNumber" class="form-label" style="width: 7.5rem">Delivery Time :</label>
                            <InputText @bind-Value="Purchase.DeliveryTime" style="width: 6rem" />
                        <label class="form-label">days</label>
                    </div>
                </div>
                <div style="display: flex; justify-content: flex-end; width: 100%">
                    <RadzenButton Size="ButtonSize.Medium" Click="create" Text="Create"
                                  Icon="add_circle" ButtonStyle="ButtonStyle.Primary"/>
                </div>
            </div>
        </div>


    </CascadingValue>
    </CascadingValue>
</EditForm>

<style>
    .label-input-group {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .label-input-group label {
        white-space: nowrap;
        font-weight: 600;
    }
</style>