@using INV.Domain.Entities.Budget
@using INV.Domain.Entities.Purchases
@using INVUIs.Shared.Models
@rendermode InteractiveServer 
@inject IStringLocalizer<Resources> Localizer

<EditForm Model="Purchase" OnValidSubmit="Save" FormName="purchaseForm" Enhance @ref="form">
    <DataAnnotationsValidator/>

    <CascadingValue Value="Chapters">
        <CascadingValue Value="Articles">
            <div style="display: grid;grid-template-columns: 1fr 1fr;grid-gap: 32px; padding-inline: 32px">
                <div>
                    <CommandInput Label=@Localizer["Purchase.Select.Budget"]>
                        <InputSelect @bind-Value="Purchase.selectedCategory" disabled="@canEdit">

                            @foreach (BudgeType category in Enum.GetValues(typeof(BudgeType)))
                            {
                                if(Purchase.selectedCategory == category)
                                {
                                    <option value="@category" selected="selected">@category.ToString()</option>
                                }else{
                                    <option value="@category">@category.ToString() </option>
                                }

                            } 

                        </InputSelect>

                    </CommandInput>
                    <CommandInput Label=@Localizer["Purchase.Choose.Chapter"] >
                        <InputSelect id="chapter" Value="Purchase.ChapterCode" disabled="@canEdit"
                        ValueExpression="@(() => Purchase.ChapterCode)" ValueChanged="@(async (int code)=>
             {Purchase.ChapterCode =code;
                await LoadArticlesBycodeChapter();
             })"
                        class="form-control valid">
                            class="form-control valid">
                            <option value="" selected>--@Localizer["Select"]--</option>
                            @if (Chapters != null)
                            {
                                @foreach (var chapter in Chapters)
                                {
                                    if(Purchase.ChapterCode == chapter.CodeChapter )
                                    {
                                        <option value="@chapter.CodeChapter" selected="selected">@chapter.CodeChapter - @chapter.Name</option>
                                    }else{
                                        <option value="@chapter.CodeChapter">@chapter.CodeChapter - @chapter.Name</option>
                                    }

                                }
                            }
                        </InputSelect>


                    </CommandInput>

                    <div class="input2">
                        <div class="commend-input">
                            <div class="label-input-group">
                                <label for="article" style="width: 10rem">@Localizer["Purchase.Choose.Article"] </label>
                                <InputSelect id="article" @bind-Value="Purchase.ArticleCode" disabled="@canEdit">
                                    class="form-control valid">
                                    <option value="" selected>--@Localizer["Select"]--</option>
                                    @if (Articles != null)
                                    {
                                        @foreach (var article in Articles)
                                        {
                                            if (Purchase.ArticleCode == article.CodeArticle)
                                            {
                                                <option value="@article.CodeArticle" selected="selected">@article.CodeArticle - @article.Name</option>
                                            }else{
                                                <option value="@article.CodeArticle">@article.CodeArticle - @article.Name</option>
                                            }

                                        }
                                    }

                                </InputSelect>
                                    </div>
                        </div>
                    </div>
                </div>
                <div>
                    <CommandInput Label=@Localizer["Purchase.Select.Service"] >
                        <InputSelect @bind-Value="Purchase.selectedService" disabled="@canEdit">

                            @foreach (ServiceType service in Enum.GetValues(typeof(ServiceType)))
                            {
                                if (Purchase.selectedService == service)
                                {
                                    <option value="@service" selected="selected">@service.ToString()</option>
                                }
                                else
                                {
                                    <option value="@service">@service.ToString() </option>
                                }

                            }

                        </InputSelect>

                    </CommandInput>
                    <div class="commend-input">
                        <div class="label-input-group">
                            <label for="productNumber" class="form-label" style="width: 7.5rem">@Localizer["Delivery.Time"]  </label>
                            <InputText @bind-Value="Purchase.DeliveryTime" style="width: 6rem" disabled="@canEdit" />
                            <label class="form-label">@Localizer["Days"]</label>
                        </div>


                    </div>



                    @if (Purchase.SupplierId == Guid.Empty)
                    {
                        <div style="display: flex; justify-content: flex-end; width: 100%">
                            <RadzenButton Size="ButtonSize.Medium" Click="create" Text=@Localizer["Register"]
                            Icon="add_circle" ButtonStyle="ButtonStyle.Success" />
                        </div>

                    }


                    @Pills

                </div>

              
            </div>

            <div class="commend-input footer-card" style="padding-left: 32px;">


                    @if (Purchase.Status == PurchaseStatus.Reject || Purchase.Status == PurchaseStatus.Vised)
                    {
                    <div class="label-input-group" style="align-items: normal !important;">
                        <label for="productNumber" class="form-label" style="width: 5rem">@Localizer["Visa.Number"] </label>

                        <label style="width: 6rem">@Purchase.VisaNumber</label>

                        </div>

                    <div class="label-input-group" style="align-items: normal !important;">
                        <label for="productNumber" class="form-label" style="width: 5rem">@Localizer["Visa.Date"] </label>

                        <label style="width: 7rem">@Purchase.VisaDate</label>
                        </div>
                    
                    }
                    @if (Purchase.Status == PurchaseStatus.Reject)
                    {
                    <div class="label-input-group" style="align-items: normal !important;">
                        <label for="productNumber" class="form-label" style="width: 5rem">@Localizer["Observation"] </label>
                        <label style="width: 6rem">@Purchase.Observation</label>

                        </div>
                    }

                </div>
      


          
        </CascadingValue>
    </CascadingValue>
</EditForm>




<style>
    .label-input-group {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .label-input-group label {
        white-space: nowrap;
        font-weight: 600;
    }
</style>