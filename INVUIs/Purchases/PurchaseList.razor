@using INV.App.Purchases
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject IStringLocalizer<Resources> Localizer

<div class="search-zone">
    <div style="width:35%">
        <input type="text" @bind="SearchTerm" placeholder="Search by order number or by supplier name" class="number-input" @bind:event="oninput" />
    </div>
    <div>
        @Pills
    </div>
</div>
@if (purchaseOrderInfos is null)
{
    <h3>@Localizer["Loading"]...</h3>
}
else
{
    <div class="Container-list">
        <RadzenDataGrid Data="@displayedItems.OrderByDescending(p => p.Date)" AllowSorting="true" AllowFiltering="true"
                        Style="width: 100%;" RowSelect="@((PurchaseOrderInfo purchaseOrderInfo) => navigatepage(purchaseOrderInfo.Id))"
                        PageSize="8" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.Status)" Title=@Localizer["Status"]>
                    <Template Context="Purchase">
                        <PurchaseStatusComponent Text="false" Icon="true" PurchaseStatus="Purchase.Status" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.Number)" Title=@Localizer["Number"] />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.Date)" Title=@Localizer["Date"] />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.BudgeType)" Title=@Localizer["BudgetType"] />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.ServiceType)" Title=@Localizer["ServiceType"] />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.BudgeArticle)" Title=@Localizer["BudgetArticle"] />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.SupplierName)" Title=@Localizer["Supplier.Name"] Visible="ShowSupplier" />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.TotalTTC)" Title=@Localizer["TotalTTC"] />
            </Columns>
        </RadzenDataGrid>
    </div>
}
