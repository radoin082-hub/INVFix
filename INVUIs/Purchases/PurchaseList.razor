@using INV.App.Purchases
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject IStringLocalizer<Resources> Localizer

<div class="search-zone">
    <div style="width:35%" class="search-container">
        <i class="bi bi-search search-icon"></i>
        <input type="text" @bind="SearchTerm" placeholder=@Localizer["Search"] class="search-input" @bind:event="oninput" />
    </div>
    <div>
        @Pills
    </div>
</div>
@if (purchaseOrderInfos is null)
{
    <h3>@Localizer["Loading"]...</h3>
}
else
{
    <div class="Container-list">
        <RadzenDataGrid Data="@displayedItems.OrderByDescending(p => p.Date)" AllowSorting="true" AllowFiltering="true"
                        Style="width: 100%;" RowSelect="@((PurchaseOrderInfo purchaseOrderInfo) => navigatepage(purchaseOrderInfo.Id))"
                        PageSize="8" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.Status)" Title=@Localizer["Status"] Filterable="false">
                    <Template Context="Purchase">
                        <PurchaseStatusComponent Text="true" Icon="true" PurchaseStatus="Purchase.Status" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.Number)" Title=@Localizer["Number"] Filterable="false" />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.Date)" Title=@Localizer["Date"] Filterable="false" />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.BudgeArticle)" Title=@Localizer["BudgetArticle"] Filterable="false" />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.SupplierName)" Title=@Localizer["Supplier"] Visible="ShowSupplier" Filterable="false" />
                <RadzenDataGridColumn Property="@nameof(PurchaseOrderInfo.TotalTTC)" Title=@Localizer["TotalTTC"] Filterable="false" />
                <RadzenDataGridColumn Title=Download Width="110px" Filterable="false">
                    <Template Context="displayedItems">
                        <div style="text-align:center">
                            <button class="btn-grid btn-download" @onclick="() => downloadFile(displayedItems.Id)" @onclick:stopPropagation="true">
                                <i class="bi bi-download"></i>
                            </button>
                        </div>

                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <EmptyTemplate>@Localizer["NothingDisplay"]</EmptyTemplate>

        </RadzenDataGrid>
    </div>
}
