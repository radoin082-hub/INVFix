@using INV.Domain.Entities.Purchases
@using INVUIs.Products.ProductsModel
@using INVUIs.Purchases.PurchaseModels
@rendermode InteractiveServer
@inject IStringLocalizer<Resources> Localizer

<CascadingValue Value="products">

    <RadzenDataGrid @ref="grid" TItem="PurchaseProductModel" Data="@products" AllowVirtualization="true" Style="height:370px"
    GridLines="DataGridGridLines.Horizontal">
        <Columns>
            <RadzenDataGridColumn Property="Number" Title=@Localizer["Number"] Width="7%">
                <Template Context="product">
                    @(products.IndexOf(product) + 1)
                </Template>

            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Designation" Title=@Localizer["Designation"] Width="34%" Visible="@(StatusButton(PurchaseInfo))">
                <FooterTemplate>
                    <div style="width: 100%; display: flex; justify-content: flex-start; align-items: center;">
                        <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Visible="!canEdit" Icon="add_circle" Text=@Localizer["Product.AddButton"] Click="() => productSelector.ShowModal()" />
                    </div>
                </FooterTemplate>
            </RadzenDataGridColumn>
         @*    <RadzenDataGridColumn Property="UnitMeasure" Title=@Localizer["UnitMeasure"] Width="10%" /> *@
            <RadzenDataGridColumn Property="Quantity" Title=@Localizer["Quantity"] Width="10%" />
            <RadzenDataGridColumn Property="UnitPrice" Title=@Localizer["UnitPrice"] Width="10%" />
            <RadzenDataGridColumn Property="TVA" Title=@Localizer["TVA"] Width="9%">
                <Template Context="product">
                    @product.TVA %
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="TotalPrice" Title=@Localizer["Total"] Width="18%">
                <Template Context="product">
                    @((product.UnitPrice * product.Quantity).ToString("N"))
                </Template>
                <FooterTemplate>
                    <div style="width: 100%; display: flex; justify-content: flex-end; align-items: center;">
                        <strong>Total TTC: @getTTC().ToString("N")</strong>
                    </div>
                </FooterTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Title="" Width="15%" Visible="@(StatusButton(PurchaseInfo))">
                <Template Context="product">
          
                        <RadzenButton ButtonStyle="ButtonStyle.Success" Click="() => EditProduct(product)" Icon="offline_pin" Visible="!canEdit"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Click="() => DeleteProduct(product)" Icon="highlight_off" Visible="!canEdit"></RadzenButton>

                    
                </Template>
            </RadzenDataGridColumn>
        </Columns>

    </RadzenDataGrid>

</CascadingValue>

<ProductSelector @ref="productSelector" OnProductSelected="AddProductToGrid" />

<ConformationForm @ref="conformationForm" Titel=@Localizer["Product.DeleteButton"] Message=@Localizer["Product.DeleteMessage"] OnConfirm="DeleteProductConformation" />

<ProductEditForm @ref="productEditForm" selectedProductModel="selectedProductModel" productEdit="loadtab"/>
