@using INV.Domain.Entities.Purchases
@using INVUIs.Products.ProductsModel
@using INVUIs.Purchases.PurchaseModels
@rendermode InteractiveServer
<CascadingValue Value="products">

    <RadzenDataGrid @ref="grid" TItem="PurchaseProductModel" Data="@products" AllowVirtualization="true" Style="height:370px"
                    GridLines="DataGridGridLines.Horizontal">
        <Columns>
            <RadzenDataGridColumn Property="Number" Title="N°" Width="7%">
                <Template Context="product">
                    @(products.IndexOf(product) + 1)
                </Template>

            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Designation" Title="Designation" Width="34%" Visible="@(StatusButton(PurchaseInfo))">
                <FooterTemplate>
                    <div style="width: 100%; display: flex; justify-content: flex-start; align-items: center;">
                        <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Icon="add_circle" Text="Add Product" Click="() => productSelector.ShowModal()"/>
                    </div>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="UnitMeasure" Title="Unit" Width="10%"/>
            <RadzenDataGridColumn Property="Quantity" Title="Quantity" Width="10%"/>
            <RadzenDataGridColumn Property="UnitPrice" Title="Unit Price" Width="10%"/>
            <RadzenDataGridColumn Property="TVA" Title="TVA" Width="9%">
                <Template Context="product">
                    @product.TVA %
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="TotalPrice" Title="Total" Width="18%">
                <Template Context="product">
                    @((product.UnitPrice * product.Quantity).ToString("N"))
                </Template>
                <FooterTemplate>
                    <div style="width: 100%; display: flex; justify-content: flex-end; align-items: center;">
                        <strong>Total TTC: @getTTC().ToString("N")</strong>
                    </div>
                </FooterTemplate>
            </RadzenDataGridColumn>
             
            <RadzenDataGridColumn Title="" Width="15%" Visible="@(StatusButton(PurchaseInfo))">
                <Template Context="product">
                    <RadzenButton ButtonStyle="ButtonStyle.Success" Click="() => EditProduct(product)" Icon="offline_pin"></RadzenButton>
                    <RadzenButton ButtonStyle="ButtonStyle.Danger" Click="() => DeleteProduct(product)" Icon="highlight_off"></RadzenButton>
                </Template>
            </RadzenDataGridColumn>
        </Columns>

    </RadzenDataGrid>

</CascadingValue>
<ProductSelector @ref="productSelector" OnProductSelected="AddProductToGrid"/>

<ConformationForm  @ref="conformationForm" Titel="Delete Product" Message="Are you sure you want to delete this Product?" OnConfirm="DeleteProductConformation" />


