@using INV.App.Receipts
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject IStringLocalizer<Resources> Localizer

<div class="search-zone">
    <div style="width:35%" class="search-container">
        <i class="bi bi-search search-icon"></i>
        <input type="text" @bind="SearchTerm" placeholder=@Localizer["Search"] class="search-input" @bind:event="oninput" />
    </div>
    <div>
        @Pills
    </div>
</div>
@if (Receptions is null)
{
  <h3>@Localizer["Loading"]...</h3>
}
else
{
    <div class="Container-list">
        <RadzenDataGrid Data="@FilteredReceptions.OrderByDescending(p => p.Date)" AllowSorting="true" AllowFiltering="true"
                        Style="width: 100%;" RowSelect="@((ReceiptInfo Receptions) => navigatepage(Receptions.Id))"
                        PageSize="6" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(ReceiptInfo.Number)" Title=@Localizer["Number"] Width="150px" />
                <RadzenDataGridColumn Property="@nameof(ReceiptInfo.Date)" Title=@Localizer["Date"] Width="150px">
                    <Template Context="reception">
                        @(reception.Date == default ? string.Empty : reception.Date.ToString())
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Title=@Localizer["Purchase"] Visible="ShowPurchase" Width="200px">
                    <Template Context="reception">
                        N° @(reception.purchaseNumber) - @(reception.PurchaseDate == default ? string.Empty : reception.PurchaseDate)
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="@nameof(ReceiptInfo.supplierName)" Title=@Localizer["Supplier.Name"] Visible="ShowSupplier" />
                <RadzenDataGridColumn Title=@Localizer["Delivery"] Sortable="false" Filterable="false" Width="200px">
                    <Template Context="reception">
                        N° @(reception.DeliveryNumber) - @(reception.DeliveryDate == default ? string.Empty : reception.DeliveryDate)
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="@nameof(ReceiptInfo.Status)" Title=@Localizer["Status"] Width="150px">
                    <Template Context="reception">
                        <ReceptionStatusComponent Text="true" Icon="true" ReceptionStatus="@reception.Status" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <EmptyTemplate>@Localizer["NothingDisplay"]</EmptyTemplate>       

        </RadzenDataGrid>
    </div>
}
