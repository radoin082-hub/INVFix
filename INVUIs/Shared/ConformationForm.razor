@if (display)
{
    <MyModal Titel="@Titel">
        <Pills>
            <div class="title-secondary">
                <h4>@Message</h4>
            </div>
            <div class="footer-form mt-4">
                <button type="button" class="btn-custom btn-cancel" @onclick="hide">NO</button>
                <button type="button" class="btn-custom btn-submit" @onclick="submit">YES</button>
            </div>
        </Pills>
    </MyModal>
}

@code {
    [Parameter] public string Titel { get; set; }
    [Parameter] public string Message { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    public bool display = false;

    public void show()
    {
        display = true;
        StateHasChanged();
    }

    public void hide()
    {
        display = false;
        StateHasChanged();
    }

    public async Task submit()
    {
        await OnConfirm.InvokeAsync();
        hide();
    }
}
