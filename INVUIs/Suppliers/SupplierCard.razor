@using INV.Domain.Entities.Suppliers
@using INVUIs.Shared
@inject IStringLocalizer<Resources> Localizer

<RadzenCard>
	<RadzenRow>
		<RadzenColumn Size="9">
			<h3>@Supplier.CompanyName</h3>
		</RadzenColumn>
		<RadzenColumn Size="3">
			@Pills
		</RadzenColumn>
	</RadzenRow>
	<RadzenRow>
		<RadzenColumn Size="6">
			<LabledValue Label=@Localizer["Phone"] Value="@Supplier.Phone" />
			<LabledValue Label=@Localizer["Email"] Value="@Supplier.Email" />

		</RadzenColumn>
		<RadzenColumn Size="6">
			<LabledValue Label=@Localizer["Address"] Value="@Supplier.Address" />
			<LabledValue Label=@Localizer["RC"] Value="@Supplier.RC" />
		</RadzenColumn>
	</RadzenRow>
	@if (moreInfoVisible)
		{
	<RadzenRow>
		<RadzenColumn Size="6">
				<LabledValue Label=@Localizer["NIS"] Value="@Supplier.NIS" />
				<LabledValue Label=@Localizer["NIF"] Value="@Supplier.NIF" />
				<LabledValue Label=@Localizer["ART"] Value="@Supplier.ART" />

		</RadzenColumn>
		<RadzenColumn Size="6">
				<LabledValue Label=@Localizer["BankAccount"] Value="@Supplier.RIB" />
				<LabledValue Label=@Localizer["BankAgency"] Value="@Supplier.BankAgency" />
		</RadzenColumn>
			
	</RadzenRow>
		}
	<RadzenRow>
		<RadzenColumn Size="12">
			<div class="btn-pos-supplier" style="display: flex; align-items: flex-end;">
				<button class="btn-custom btn-cancel" type="button" @onclick="showMore">@Localizer["MoreInfo"]...</button>
			</div>

		</RadzenColumn>

	</RadzenRow>

</RadzenCard>


