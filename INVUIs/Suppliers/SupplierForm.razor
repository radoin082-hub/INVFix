@inject IStringLocalizer<Resources> Localizer

@if (displayModal)
{
    <MyModal>
        <Pills>
            <EditForm Model="newSupplier" OnValidSubmit="OnCreate" FormName="AddSupplier" style=" width:600px">
                <DataAnnotationsValidator />
         
                <div class="commend-content">
                    <div class="titel-primary">
                        <h2>@(Update ? @Localizer["Supplier.Edit"]: @Localizer["Supplier.Information"])</h2>
                    </div>

                    <div class="input">
                        <div class="commend-input">
                            <label>@Localizer["FullName"]</label>
                            <InputText @bind-Value="newSupplier.NameSupplier" placeholder=@Localizer["Supplier.Name.Enter"] />
                            <ValidationMessage For="() => newSupplier.NameSupplier" />
                        </div>
                    </div>
                    <div class="input">
                        <div class="commend-input">
                            <label>@Localizer["Company.Name"]</label>
                            <InputText @bind-Value="newSupplier.NameCompany" placeholder=@Localizer["Company.Name.Enter"] />
                            <ValidationMessage For="() => newSupplier.NameCompany" />
                        </div>
                    </div>
                    <div class="input">
                        <div class="commend-input">
                            <label>@Localizer["Address"]</label>
                            <InputText @bind-Value="newSupplier.Address" placeholder=@Localizer["Supplier.Address.Enter"] />
                            <ValidationMessage For="() => newSupplier.Address" />
                        </div>
                    </div>

                    <div class="input2">
                        <div class="commend-input">
                            <label>@Localizer["Phone"]</label>
                            <InputText @bind-Value="newSupplier.Phone" placeholder=@Localizer["Supplier.Phone.Enter"] />
                            <ValidationMessage For="() => newSupplier.Phone" />
                        </div>
                        <div class="commend-input">
                            <label>@Localizer["Email"]</label>
                            <InputText @bind-Value="newSupplier.Email" placeholder=@Localizer["Supplier.Email.Enter"] />
                            <ValidationMessage For="() => newSupplier.Email" />
                        </div>
                    </div>

                    <div class="input2">
                        <div class="commend-input">
                            <label>@Localizer["RC"]</label>
                            <InputText @bind-Value="newSupplier.RC" placeholder=@Localizer["RC.Enter"] />
                            <ValidationMessage For="() => newSupplier.RC" />
                        </div>
                        <div class="commend-input">
                            <label>@Localizer["ART"]</label>
                            <InputText @bind-Value="newSupplier.ART" placeholder=@Localizer["ART.Enter"] />
                            <ValidationMessage For="() => newSupplier.ART" />
                        </div>
                    </div>

                    <div class="input2">
                        <div class="commend-input">
                            <label>@Localizer["NIF"]</label>
                            <InputText @bind-Value="newSupplier.NIF" placeholder=@Localizer["NIF.Enter"] />
                            <ValidationMessage For="() => newSupplier.NIF" />
                        </div>
                        <div class="commend-input">
                            <label>@Localizer["NIS"]</label>
                            <InputText @bind-Value="newSupplier.NIS" placeholder=@Localizer["NIS.Enter"] />
                            <ValidationMessage For="() => newSupplier.NIS" />
                        </div>
                    </div>

                    <div class="input2">
                        <div class="commend-input">
                            <label>@Localizer["BankAccount"]</label>
                            <InputText @bind-Value="newSupplier.RIB" placeholder=@Localizer["BankAccount.Enter"] />
                            <ValidationMessage For="() => newSupplier.RIB" />
                        </div>

                        <div class="commend-input">
                            <label>@Localizer["BankAgency"]</label>
                            <InputText @bind-Value="newSupplier.BankAgency" placeholder=@Localizer["BankAgency.Enter"] />
                            <ValidationMessage For="() => newSupplier.BankAgency" />
                        </div>
                    </div>

                    <div class="footer-form">
                        <button class="btn-custom btn-cancel" type="button" @onclick="close">@Localizer["Cancel"]</button>
                        <button class="btn-custom btn-submit" type="submit">@((Update ? @Localizer["Save"] : @Localizer["Register"]))</button>
                    </div>
                </div>
            </EditForm>
        </Pills>
    </MyModal>
}
