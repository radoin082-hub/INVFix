@using INV.App.Suppliers
@rendermode InteractiveServer
@inject IStringLocalizer<Resources> Localizer

<button type="button" class="addsupplier-button" @onclick=@showSupplierForm>
    <i class="bi bi-person-plus"></i> @Localizer["Supplier.AddButton"]
</button>
<div>
    <input type="text" @bind="searchName" @bind:event="oninput" placeholder="Search by supplier name" class="number-input" />
</div>
<br>
@if (supplierFilter is null)
{
    <h3>@Localizer["Loading"]...</h3>
}
else
{

    <div class="Container-list">
        <RadzenDataGrid @ref="grid" Data="@supplierFilter" AllowSorting="true" AllowFiltering="true"
                        Style="width: 100%;" RowSelect="@((SupplierInfo supplier) => NavigateToSupplierDetails(supplier.ID))">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(SupplierInfo.CompanyName)" Title=@Localizer["Supplier"] Width="10%" />
                <RadzenDataGridColumn Property="@nameof(SupplierInfo.Email)" Title=@Localizer["Email"] Width="10%" />
                <RadzenDataGridColumn Property="@nameof(SupplierInfo.Phone)" Title=@Localizer["Phone"] Width="10%" />
                <RadzenDataGridColumn Property="@nameof(SupplierInfo.Address)" Title=@Localizer["Address"] Width="10%" />

                <RadzenDataGridColumn  Width="5%">
                    <Template Context="supplier" >
                        <RadzenButton Icon="delete" ButtonStyle="@ButtonStyle.Danger"
                                      
                                      @onclick:stopPropagation="true"
                                      Click="@(() => DeleteSupplier(supplier))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>



    </div>

}

<SupplierForm @ref=supplierForm Update="false"/>
<ConformationForm @ref="conformationForm" Titel=@Localizer["Supplier.DeleteButton"] Message=@Localizer["Supplier.DeleteMessage"] OnConfirm="ConfirmDeleteSupplier" />
