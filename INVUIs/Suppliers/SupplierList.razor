@using INV.App.Suppliers
@rendermode InteractiveServer
@inject IStringLocalizer<Resources> Localizer
<div class="search-zone">
    <div style="width:35%">
        <input type="text" @bind="searchName" @bind:event="oninput" placeholder=@Localizer["Search"] class="number-input" />
    </div>
    <div>
        <button type="button" class="addsupplier-button" @onclick=@showSupplierForm>
            <i class="bi bi-person-plus"></i> @Localizer["Suppliers.AddButton"]
        </button>
    </div>


</div>


@if (supplierFilter is null)
{
    <h3>@Localizer["Loading"]...</h3>
}
else
{

    <div class="Container-list">
        <RadzenDataGrid @ref="grid" Data="@supplierFilter" AllowSorting="true" AllowFiltering="true"
                        PageSize="6" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true" Style="width: 100%;"
                        RowSelect="@((SupplierInfo supplier) => NavigateToSupplierDetails(supplier.ID))">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(SupplierInfo.CompanyName)" Title=@Localizer["Supplier"] Width="10%" />
                <RadzenDataGridColumn Property="@nameof(SupplierInfo.Email)" Title=@Localizer["Email"] Width="10%" />
                <RadzenDataGridColumn Property="@nameof(SupplierInfo.Phone)" Title=@Localizer["Phone"] Width="10%" Filterable="false" />
                <RadzenDataGridColumn Property="@nameof(SupplierInfo.Address)" Title=@Localizer["Address"] Width="10%" Filterable="false" />

                <RadzenDataGridColumn Width="4%" Filterable="false">
                    <Template Context="supplier">
                        <RadzenButton Icon="delete" ButtonStyle="@ButtonStyle.Danger"
                                      @onclick:stopPropagation="true"
                                      Click="@(() => DeleteSupplier(supplier))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>



    </div>

}

<SupplierForm @ref=supplierForm Update="false" />
<ConformationForm @ref="conformationForm" Titel=@Localizer["Suppliers.DeleteButton"] Message=@Localizer["Suppliers.DeleteMessage"] OnConfirm="ConfirmDeleteSupplier" />
