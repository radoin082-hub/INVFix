@inject IStringLocalizer<Resources> localizer
@inject IStringLocalizer<Resources> localizer
@{
    string userName = "Ali Sriti";  
    string userInitial = userName.Length > 0 ? userName[0].ToString() : "";  
}


<div class="mynavbar">
    <div class="search-container">
        <i class="bi bi-search search-icon"></i>
        <input type="text" class="search-input" placeholder=@localizer["Search"] />

    </div>

    <div class="icons-container">
        <CultureSelector/>
        <button class="theme-toggle" style="color: black;">
            <i class="bi bi-brightness-high"></i>
        </button>

        <div class="notification-container">
            <button class="notification-button" style="color: black;">
                <i class="bi bi-bell"></i>
                <span class="notification-badge">3</span>
            </button>
            <div class="notification-dropdown">
                <p>Alert 1: Update available</p>
                <p>Alert 2: New reception added</p>
                <p>Alert 3: Low stock on a product</p>
            </div>
        </div>
    <div class="user-profile">
            <span class="user-initials">@userInitial</span> 
            <span class="user-name">Ali Sriti</span>
            <div class="user-dropdown">
                <p>👤 My Profile</p>
                <p>⚙️ Settings</p>
                <p>🚪 Log Out</p>
            </div>

            </div>
        </div>
    </div>




