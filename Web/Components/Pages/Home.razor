@page "/"

@inject IStringLocalizer<Resources> Localizer

<PageTitle>@Localizer["Dashboard"] </PageTitle>
<!--@Thread.CurrentThread.CurrentCulture;
@Thread.CurrentThread.CurrentUICulture; -->

<PageHeader Title=@Localizer["Dashboard.Title"] SubTitle=@Localizer["Dashboard.SubTitle"] />

<div class="dashboard-part1">
    <DashboardCardInfo Title=@Localizer["Products"] IconSrc="bi bi-box-seam" Count="@productCount" />
    <DashboardCardInfo Title=@Localizer["Suppliers"] IconSrc="bi bi-person" Count="@supplierCount" />
    <DashboardCardInfo Title=@Localizer["Purchases"] IconSrc="bi bi-cart-check" Count="@purchaseCount" />
    <DashboardCardInfo Title=@Localizer["Receptions"] IconSrc="bi bi-clipboard-check" Count="@receptionCount" />
</div>

<div class="dashboard-part2">
    <div class="graph-1">
        <RadzenStack class="rz-p-0 rz-p-md-6 rz-p-lg-12">
            <RadzenCard Variant="Radzen.Variant.Outlined">


                <RadzenRow>
                    <RadzenColumn Size="12">
                        <h4>@Localizer["Purchase.Status"]</h4>
                        <h6 style="text-align:center; color:gray">  @Localizer["Year"]: @currentYear  </h6>
                        <RadzenChart>
                            <RadzenColumnSeries Data="@revenue"
                            CategoryProperty="Quarter"
                            ValueProperty="Revenue"
                                                Fills="@(new string[] { "#EF4444", "#3B82F6", "#4ade80" })">
                            </RadzenColumnSeries>
                            <RadzenValueAxis Formatter="@FormatAsUSD" Min="0">
                                <RadzenGridLines Visible="true" />
                                <RadzenLegend Visible="false" />
                            </RadzenValueAxis>
                        </RadzenChart>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        </RadzenStack>
    </div>

    <div class="graph-2">
        <RadzenStack class="rz-p-0 rz-p-md-6 rz-p-lg-12">
            <RadzenCard Variant="Variant.Outlined">


                <RadzenRow>
                    <RadzenColumn Size="12">
                        <h4>@Localizer["Reception.Status"]</h4>
                        <h6 style="text-align:center; color:gray">  @Localizer["Year"]: @currentYear  </h6>
                        <RadzenChart>
                            <RadzenColumnSeries Data="@revenue2"
                            CategoryProperty="Quarter2"
                            ValueProperty="Revenue2"
                                                Fills="@(new string[] { "#4ade80", "#3B82F6" })">
                            </RadzenColumnSeries>

                            <RadzenValueAxis Formatter="@FormatAsUSD" Min="0">
                                <RadzenGridLines Visible="true" />      
                                <RadzenLegend Visible="false"/>
                            </RadzenValueAxis>
                        </RadzenChart>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        </RadzenStack>
    </div>
</div>

@code {
    @using INV.App.Receipts
    @using INV.App.Purchases
    @using INV.App.Products
    @using INV.App.Suppliers
    @using Radzen
    @using BlazorBootstrap

    [Inject] ISupplierService supplierService { get; set; }
    [Inject] IProductService productService { get; set; }
    [Inject] IPurchaseOrderService purchaseOrderService { get; set; }
    [Inject] IReceiptService receiptService { get; set; }

    bool showDataLabels = false;
    bool showDataLabels2 = false;
    private int supplierCount = 0;
    private int productCount = 0;
    private int receptionCount = 0;
    private int purchaseCount = 0;
    private List<int> listReceptionStatus;
    private List<int> listPurchaseStatus;

    private DataItem[] revenue;
    private DataItem[] revenue2;
    private DateOnly currentDate;
    private int currentYear;



    protected override async Task OnInitializedAsync()
    {
        currentDate = DateOnly.FromDateTime(DateTime.Now);
        currentYear = currentDate.Year;

        supplierCount = await supplierService.GetSupplierCountAsync();
        productCount = await productService.GetProductCountAsync();
        purchaseCount = await purchaseOrderService.GetPurchaseCount();
        receptionCount = await receiptService.GetReceptionCount();
        listReceptionStatus = await receiptService.GetReceptionStatusCount();
        listPurchaseStatus = await purchaseOrderService.GetPurchaseCountsByStatus();

        revenue = new DataItem[] {
            new DataItem { Quarter =  @Localizer["Rejected"], Revenue = listPurchaseStatus[1] },
            new DataItem { Quarter = @Localizer["Editing"], Revenue = listPurchaseStatus[0] },
            new DataItem { Quarter = @Localizer["Validated"], Revenue = listPurchaseStatus[2] }
    };

        revenue2 = new DataItem[] {
            new DataItem { Quarter2 = @Localizer["Validated"], Revenue2 = listReceptionStatus[0] },
            new DataItem { Quarter2 = @Localizer["Editing"], Revenue2 = listReceptionStatus[1] }
    };
    }

    void OnSeriesClick(SeriesClickEventArgs args)
    {
    }
    string FormatAsUSD(object value)
    {
        return ((double)value).ToString();
    }

    class DataItem
    {
        public string Quarter { get; set; }
        public double Revenue { get; set; }

        public string Quarter2 { get; set; }
        public double Revenue2 { get; set; }
    }
}
