@page "/"

<PageHeader Title="Dashboard" SubTitle="Overview of your inventory management system" />

<div class="dashboard-part1">
    <DashboardCardInfo Title="Total Products" IconSrc="bi bi-box-seam me-3" Count="@productCount" />
    <DashboardCardInfo Title="Suppliers" IconSrc="bi bi-person" Count="@supplierCount" />
    <DashboardCardInfo Title="Purchase Orders" IconSrc="bi bi-cart-check me-3" Count="@purchaseCount" />
    <DashboardCardInfo Title="Receptions" IconSrc="bi bi-clipboard-check me-3" Count="@receptionCount" />
</div>


<div class="dashboard-part2">
    <div class="graph-1">
        <RadzenStack class="rz-p-0 rz-p-md-6 rz-p-lg-12" AlignItems="Radzen.AlignItems.Center">
            <RadzenCard Variant="Radzen.Variant.Outlined" Style="width: 100%;">
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="Radzen.AlignItems.End" Gap="0.5rem" Wrap="Radzen.FlexWrap.Wrap">
                    <RadzenCheckBox @bind-Value="@showDataLabels" Name="dataLabels"></RadzenCheckBox>
                    <RadzenLabel Text="Purchase Status" Component="dataLabels" />
                </RadzenStack>
            </RadzenCard>

            <RadzenStack Style="width: 90%; max-width: 600px;">
                <RadzenChart SeriesClick=@OnSeriesClick>
                    <RadzenPieSeries Data="@revenue" Title="Revenue" CategoryProperty="Quarter" ValueProperty="Revenue" Fills="@(new string[] { "#f44336", "#2196f3", "#4caf50" })">
                        <RadzenSeriesDataLabels Visible="@showDataLabels" />
                    </RadzenPieSeries>
                </RadzenChart>
            </RadzenStack>
        </RadzenStack>
    </div>

    <div class="graph-2">
        <RadzenStack class="rz-p-0 rz-p-md-6 rz-p-lg-12" AlignItems="Radzen.AlignItems.Center">
            <RadzenCard Variant="Radzen.Variant.Outlined" Style="width: 100%;">
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="Radzen.AlignItems.Center" Gap="0.5rem" Wrap="Radzen.FlexWrap.Wrap" >
                    <RadzenCheckBox @bind-Value="@showDataLabels2" Name="dataLabels"></RadzenCheckBox>
                    <RadzenLabel Text="Reception Status" Component="dataLabels" />
                </RadzenStack>
            </RadzenCard>

            <RadzenStack Style="width: 100%; max-width: 600px;">
                <RadzenChart SeriesClick=@OnSeriesClick>
                    <RadzenPieSeries Data="@revenue2" Title="Reception" CategoryProperty="Quarter2" ValueProperty="Revenue2" Fills="@(new string[] { "#4caf50", "#2196f3" })">
                        <RadzenSeriesDataLabels Visible="@showDataLabels2" />
                    </RadzenPieSeries>
                </RadzenChart>
            </RadzenStack>
        </RadzenStack>
    </div>

</div>








@code {
    @using INV.App.Receipts
    @using INV.App.Purchases
    @using INV.App.Products
    @using INV.App.Suppliers
    @using Radzen
    @using BlazorBootstrap

    [Inject] ISupplierService supplierService { get; set; }
    [Inject] IProductService productService { get; set; }
    [Inject] IPurchaseOrderService purchaseOrderService { get; set; }
    [Inject] IReceiptService receiptService { get; set; }

    bool showDataLabels = false;
    bool showDataLabels2 = false;
    private int supplierCount = 0;
    private int productCount = 0;
    private int receptionCount = 0;
    private int purchaseCount = 0;
    private List<int> listReceptionStatus;
    private List<int> listPurchaseStatus;

    private DataItem[] revenue;
    private DataItem[] revenue2;

    protected override async Task OnInitializedAsync()
    {
        supplierCount = await supplierService.GetSupplierCountAsync();
        productCount = await productService.GetProductCountAsync();
        purchaseCount = await purchaseOrderService.GetPurchaseCount();
        receptionCount = await receiptService.GetReceptionCount();
        listReceptionStatus = await receiptService.GetReceptionStatusCount();
        listPurchaseStatus = await purchaseOrderService.GetPurchaseCountsByStatus();


        revenue = new DataItem[] {
            new DataItem
            {
                Quarter = "Rejected",
                Revenue = listPurchaseStatus[0]
            },
            new DataItem
            {
                Quarter = "Editing",
                Revenue = listPurchaseStatus[1]
            },
            new DataItem
            {
                Quarter = "Validated",
                Revenue = listPurchaseStatus[2]
            },
    };

        revenue2 = new DataItem[] {
            new DataItem
            {
                Quarter2 = "Validated",
                Revenue2= listReceptionStatus[0]
            },
            new DataItem
            {
                Quarter2 = "Editing",
                Revenue2 = listReceptionStatus[1]
            },
    };
    }

    void OnSeriesClick(SeriesClickEventArgs args)
    {
    }
 

    class DataItem
    {
        public string Quarter { get; set; }
        public double Revenue { get; set; }

        public string Quarter2 { get; set; }
        public double Revenue2 { get; set; }
    }
}