@page "/products/{productId:guid}"
@inject IStringLocalizer<Resources> Localizer

@using INV.App.Products
@using INV.App.Receipts

@inject IProductService ProductService


<PageTitle>@Localizer["Product.Details"]</PageTitle>

<PageHeader Title=@Localizer["Product.Title"] />

@if (product != null)
{
    <RadzenCard>
        <h3>@product.Designation</h3>
        <RadzenRow>
            <RadzenColumn Size="6">
                <p>
                    <strong> @Localizer["Quantity"] :</strong> @product.Quantity

                </p>
               

            </RadzenColumn>
            <RadzenColumn Size="6">
                <p>
                    <strong>@Localizer["Stock"] :</strong> @product.WareHouse
                </p>
                <p><strong>@Localizer["TVA"] :</strong> @product.TVA%</p>
                <p>
                    <strong>@Localizer["UnitMeasure"]  :</strong> @product.UnitMeasure
                </p>
            </RadzenColumn>
        </RadzenRow>
            <RadzenRow>
                    <RadzenColumn Size="12">
                <div class="footer-form" style="display:flex;flex-direction: row-reverse;">
                    <button class="btn-custom btn-submit" @onclick="() => ShowProductFormModal(product)">@Localizer["Edit"]</button>
                </div>
              
                    </RadzenColumn> 
            </RadzenRow>
    </RadzenCard>

    @if (product.ReceiptInfos != null)
    {
        <RadzenTabs>
            <Tabs>
                <RadzenTabsItem Text=@Localizer["Receptions"]>
                    <RadzenDataGrid Data="@product.ReceiptInfos" TItem="ReceiptInfo">
                        <Columns>
                            <RadzenDataGridColumn TItem="ReceiptInfo" Property="Number" Title=@Localizer["Number"] />
                            <RadzenDataGridColumn TItem="ReceiptInfo" Property="Date" Title=@Localizer["Date"] />
                            <RadzenDataGridColumn TItem="ReceiptInfo" Property="supplierName" Title=@Localizer["Supplier.Name"] />
                            <RadzenDataGridColumn Title=@Localizer["Delivery"]>
                                <Template Context="reception">
                                    N° @(reception.DeliveryNumber) - @(reception.DeliveryDate == default ? string.Empty : reception.DeliveryDate)
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ReceiptInfo" Property="Status" Title=@Localizer["Status"] />
                        </Columns>
                        <EmptyTemplate>@Localizer["NothingDisplay"]</EmptyTemplate>

                    </RadzenDataGrid>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    }
}
else
{
    <p>@Localizer["Loading"]...</p>
}
<ProductForm @ref="ProductForm" productEdit="product"  />