@page "/purchases/create"
@rendermode InteractiveServer
@inject IStringLocalizer<Resources> Localizer


<PageTitle>@Localizer["Purchase.New"]</PageTitle>

<PageHeader Title=@Localizer["Purchase.New.Title"] />
@if (showAlert)
{
    <Alert Color="AlertColor.Warning">
        <Icon Name="IconName.ExclamationTriangleFill" class="me-2"></Icon>
        @errorMessage
    </Alert>
}

<CascadingValue Value="chapters">
    <CascadingValue Value="articles">
         <PurchaseHeader @ref="purchaseHeaderRef" OnCreate="create" Purchase="purchaseModel" /> 
    </CascadingValue>
</CascadingValue>

<RadzenTabs RenderMode="TabRenderMode.Client">
    <Tabs>
            <RadzenTabsItem Text=@Localizer["EconomicOperator"]>

            <CascadingValue Value="selectedSupplier">
                <PurchaseSupplier OnSupplierSelected="@(supplier => selectedSupplier = supplier)" />
            </CascadingValue>
        </RadzenTabsItem>

            <RadzenTabsItem Text=@Localizer["Products.Order"]>

            <CascadingValue Value="productModel">
                <PurchaseProducts/>
            </CascadingValue>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>