@page "/purchases"
@using INVUIs.Shared
@inject IStringLocalizer<Resources> Localizer


<PageTitle>@Localizer["Purchases"]</PageTitle>
<PageHeader Title=@Localizer["Purchases.Title"] SubTitle=@Localizer["Purchases.SubTitle"] />
<input type="text" @bind-value="SearchTerm" placeholder=@Localizer["Purchases.Search"] class="number-input" @bind-value:event ="oninput" />
<button type="button" class="addsupplier-button" @onclick="NavigateToPurchaseOrder"><i class="bi bi-cart-plus"></i> @Localizer["Purchase.AddButton"] </button>

<PurchaseList purchaseOrderInfos="purchaseOrderInfos">
</PurchaseList>