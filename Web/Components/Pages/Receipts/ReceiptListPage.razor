@page "/receptions"
@inject IStringLocalizer<Resources> Localizer

<PageTitle>@Localizer["Receptions"]</PageTitle>
<PageHeader Title=@Localizer["Receptions.Title"] SubTitle=@Localizer["Receptions.SubTitle"] />

<ReceptionList Receptions=@receipts>
	<Pills>
		<button type="button" class="addsupplier-button" @onclick="() => purchaseSelector.ShowModal()"><i class="bi bi-clipboard-plus"></i> @Localizer["Receptions.SelectPurchase"]</button>
		<PurchaseSelector Title=@Localizer["Receptions.SelectPurchase"] Command="purchases" OnSelected="CommandSelectednew" @ref="purchaseSelector" />
	</Pills>
</ReceptionList>
