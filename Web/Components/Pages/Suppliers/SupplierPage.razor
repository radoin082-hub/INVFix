@page "/suppliers/{id:guid}"
@inject IStringLocalizer<Resources> Localizer

@rendermode InteractiveServer

<PageTitle>@Localizer["Supplier.Profile"]</PageTitle>

@if (supplier is not null)
{
    <PageHeader Title=@supplier.ManagerName />

    <div class="content-profile">
        <div style="width:100%" class="mb-3">
            
            <SupplierCard Supplier="supplier">

                <Pills>

                    <div style="display: flex; justify-content: flex-end;">
                        <button class="btn-custom btn-submit" type="button" @onclick="editSupplier">
                            <i class="bi bi-pen"></i> @Localizer["Edit"]
                        </button>
                    </div>

                </Pills>

            </SupplierCard>
           
           

        </div>

        <div class="container-work-supplier">
            <Tabs>
                <Tab Title=@Localizer["Purchases"] IsActive="true">
                    <Content>
                        <PurchaseList purchaseOrderInfos="purchases" ShowSupplier="false" />
                    </Content>
                </Tab>
                @if (receptions != null && receptions.Count > 0)
                {
                    <Tab Title=@Localizer["Receptions"]>
                        <Content>
                            <ReceptionList Receptions="receptions" ShowSupplier="false" ShowPurchase="true" />
                        </Content>
                    </Tab>
                }
              
            </Tabs>

        </div>
    </div>
}
<SupplierForm @ref="supplierForm" Update="true" OnSupplierCreated="OnSupplierSaved" />
